# CPU: plain Python with the CPU torch wheels.
FROM python:3.12-slim
WORKDIR /srv
RUN pip install --no-cache-dir torch==2.9.1 torchvision --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY server.py .
ENV NORTH_DEVICE=cpu HF_HOME=/hf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health').status==200 else 1)"
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
